# ============================================================
# AgentForge 环境配置模板（脱敏版，复制为 .env 后填写真实值）
# cp .env.example .env
# ============================================================

# ---- LLM 提供商 ----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat
DEEPSEEK_EMBED_MODEL=text-embedding-3-small

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- 向量嵌入（Embedding，D9 新增）----
# ⚠ 必须与 chat 通道分开配：DeepSeek 没有 embeddings 接口（实测 /embeddings 返回 404）。
# 切 provider 只改这三个键 → 重启即可，业务代码零改动。
# ⚠ EMBEDDING_DIM 必须与 EMBEDDING_MODEL 一致，改模型要重建向量索引（表里 Vector(dim) 是定死的）。
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DIM=512

# ---- 基础设施 ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=agentforge

REDIS_HOST=localhost
REDIS_PORT=6379

# ---- 可观测（Langfuse）----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- 外部 MCP Server：Harness（D25 起，D27 接入）----
# 用途：PRD §4.2 交付项 S10「来自外部、不归我们维护」的 Server。
# ⚠ 这是你账号的全权凭证（个人 PAT 继承账号全部权限，创建时没有"只读"选项）。
#    真正的只读在 **server 那一侧**：起进程时给它 HARNESS_READ_ONLY=true，
#    服务端就会拦掉 create/update/delete/execute，只放行 list/get。
#    注意 HARNESS_READ_ONLY 是**给 MCP server 进程的环境变量**（spawn 时传），
#    不是本应用读的配置 —— 所以别写在本文件里，写在拉起 server 的地方。
# 格式：pat.<accountId>.<tokenId>.<secret>，accountId 自动提取，不用另配账号 ID。
# ⚠ 本文件是模板，永远不要在这里填真实 token；.env 已被 .gitignore 忽略。
HARNESS_API_KEY=

# ---- MCP 客户端（D27 新增）----
# 总开关：关掉则完全不接任何外部 server，注册表只剩项目内静态注册的工具。
MCP_ENABLED=true

# 外部 server（Harness 官方 MCP）开关，**默认 false**。
# 为什么默认关：它每次启动都要拉一个常驻 npm 子进程（冷启动可能几分钟），
# 而绝大多数开发/回归用不到它。只读自研库存 server 是本机 python 起进程、毫秒级。
# 演示 / 验收 D27（/api/tools 能看到 11 个 harness 工具）时才打开。
MCP_HARNESS_ENABLED=false
MCP_HARNESS_COMMAND=npx
MCP_HARNESS_ARGS=-y harness-mcp-v2@latest
# ⚠ 国内环境必配镜像：实测直连 registry.npmjs.org **超时**（curl 12s 返回 000），
#   加镜像后 2 分 31 秒拉完；不加会挂住 5 分钟以上且没有任何输出。
MCP_NPM_REGISTRY=https://registry.npmmirror.com
# 只读（= spawn 时给 server 传 HARNESS_READ_ONLY=true）+ 写操作人工确认阈值。
# ⚠ 阈值写错的后果是**防护静默降级**：系统照常跑，只是把危险操作放行了。
#   所以它和 RETRIEVER_CONFIG / JUDGE_MODEL 一样，在配置层就拦非法值。
MCP_HARNESS_READ_ONLY=true
MCP_HARNESS_AUTO_APPROVE_RISK=none

# ⚠ 一个已经踩过的坑，记在这里免得再犯：
#   MCP 客户端给子进程传环境变量时**必须用显式白名单**，不能 `{**os.environ}` 全透传。
#   实测：本文件里的 LOG_LEVEL=INFO（大写）透传进去后，harness server 启动瞬间
#   Fatal error 自杀（它只认 debug|info|warn|error 小写枚举）。
#   现在客户端只传 PATH/HOME/TMPDIR + HARNESS_* + 覆写成小写的 LOG_LEVEL=info。

# ---- 应用 ----
APP_ENV=dev
LOG_LEVEL=INFO
